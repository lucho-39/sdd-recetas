# ==============================================================================
# Recetario IA - Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# ==============================================================================

# ==============================================================================
# APPLICATION
# ==============================================================================
ENVIRONMENT=development
# ENVIRONMENT=production

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
POSTGRES_USER=recetario
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_DB=recetario

# Database URL for SQLAlchemy (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://recetario:changeme_secure_password_here@postgres:5432/recetario

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_strong_random_secret_at_least_32_chars_long

# Algorithm for JWT signing (RS256 requires public/private key pair)
# For development, you can use HS256 with a shared secret
JWT_ALGORITHM=HS256

# Access token expiration in minutes (15 minutes recommended)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration in days (30 days recommended)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# ADMIN BOOTSTRAP
# ==============================================================================
# Initial admin credentials (used only on first bootstrap)
# Change these immediately after first login!
ADMIN_INITIAL_USER=admin@recetario.local
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin123!

# ==============================================================================
# CORS
# ==============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================================================
# FRONTEND (SvelteKit)
# ==============================================================================
# Frontend port
PORT=3000
HOST=0.0.0.0
ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# ADMIN (SvelteKit)
# ==============================================================================
# Admin port
ADMIN_PORT=3001
ADMIN_HOST=0.0.0.0
ADMIN_ORIGIN=http://localhost:3001

# ==============================================================================
# EMAIL (for verification, password reset, etc.) - Optional for MVP
# ==============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=changeme
# EMAIL_FROM=noreply@recetario.local

# ==============================================================================
# REDIS (for caching, rate limiting, sessions) - Optional for MVP
# ==============================================================================
# REDIS_URL=redis://redis:6379/0

# ==============================================================================
# STORAGE (S3-compatible for images) - Optional for MVP
# ==============================================================================
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=recetario-images
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=us-east-1

# ==============================================================================
# MONITORING & OBSERVABILITY - Optional
# ==============================================================================
# SENTRY_DSN=
# LOG_LEVEL=info