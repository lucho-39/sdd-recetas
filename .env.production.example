# Recetario IA — ejemplo de entorno de PRODUCCIÓN en tu server.
# Copiá a `.env` en el server y completá cada valor. Nada de esto va a git.
#
# Generar secretos (en el server):
#   openssl rand -hex 32   # JWT_SECRET
#   openssl rand -hex 16   # POSTGRES_PASSWORD y ADMIN_INITIAL_PASSWORD

# --- Núcleo ---
ENVIRONMENT=production
DEBUG=false

# --- Dominios gratuitos (p. ej. DuckDNS, ver docs/architecture/03-deployment.md) ---
APP_DOMAIN=tu-app.duckdns.org
ADMIN_DOMAIN=tu-app-admin.duckdns.org
FRONTEND_URL=https://tu-app.duckdns.org
OAUTH_REDIRECT_BASE=https://tu-app.duckdns.org
CORS_ORIGINS=https://tu-app.duckdns.org,https://tu-app-admin.duckdns.org

# --- Base de datos ---
POSTGRES_USER=recetario
POSTGRES_PASSWORD=CAMBIA_ESTO_16_BYTES_MINIMO
POSTGRES_DB=recetario

# --- Auth (nunca dejes los defaults en producción) ---
JWT_SECRET=CAMBIA_ESTO_32_BYTES_MINIMO
JWT_ALGORITHM=HS256

# --- Bootstrap admin (cambiar en el primer login; el sistema lo exige) ---
ADMIN_INITIAL_USER=admin@tudominio.local
ADMIN_INITIAL_PASSWORD=CAMBIA_ESTA_CLAVE_LARGA_Y_UNICA

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5

# --- Email (vacío = los correos quedan en la tabla email_outbox, sin enviar) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tu-app.duckdns.org
